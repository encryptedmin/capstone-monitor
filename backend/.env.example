# MySQL connection used by Django and start system.bat.
DB_NAME=capstone_monitor
DB_USER=root
DB_PASSWORD=change_this_to_your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Django settings (change the secret before exposing the app beyond localhost).
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
